# Eventifive Environment Variables
# Copy this file to .env and fill in your values

# ==========================================
# BETTER AUTH
# ==========================================
# Secret key for Better Auth - generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_character_secret_key_here

# Base URL for Better Auth callbacks
BETTER_AUTH_URL=http://localhost:3000/

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=http://localhost:3000/

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Local: postgresql://user:password@localhost:5432/eventifive
# Neon: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/eventifive

# ==========================================
# CLOUDFLARE TURNSTILE (CAPTCHA)
# ==========================================
# Get keys from: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTYLE_PK=0x4AAAAAAxxxxxxxxxxxxxxxxxx
CLOUDFLARE_TURNSTYLE_SK=0x4AAAAAAxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# EMAIL (RESEND)
# ==========================================
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_SENDER_EMAIL=noreply@yourdomain.com

# ==========================================
# GOOGLE OAUTH
# ==========================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# ARCJET (Rate Limiting)
# ==========================================
# Get API key from: https://app.arcjet.com
ARCJET_API=ajkey_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# CLOUDFLARE R2 (File Storage)
# ==========================================
# Get credentials from: https://dash.cloudflare.com/?to=/:account/r2
NEXT_PUBLIC_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com/
S3_BUCKET_NAME=your-bucket-name
S3_REGION=auto
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# REDIS (Upstash)
# ==========================================
# Get URL from: https://console.upstash.com
REDIS_URL=redis://default:xxxxxx@xxx-xxx-00000.upstash.io:6379

# ==========================================
# WEBSOCKET
# ==========================================
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8081

# ==========================================
# CHARGILY (Payments - Optional)
# ==========================================
# Get keys from: https://pay.chargily.com/dashboard
CHARGILY_SK=test_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CHARGILY_PK=test_pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# OPTIONAL
# ==========================================
OPEN_AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NODE_ENV=development
