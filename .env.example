# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.ts"
# should be updated accordingly.

# ==========================================
# BETTER AUTH
# ==========================================
# Secret key for Better Auth (required in production)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL for Better Auth callbacks
BETTER_AUTH_URL="http://localhost:3000/"

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Allowed CORS origin
CORS_ORIGIN="http://localhost:3000/"

# ==========================================
# DATABASE
# ==========================================
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/eventifive"

# ==========================================
# CLOUDFLARE TURNSTILE (CAPTCHA)
# ==========================================
# Public site key (visible in client)
NEXT_PUBLIC_CLOUDFLARE_TURNSTYLE_PK=""
# Secret key (server-side only)
CLOUDFLARE_TURNSTYLE_SK=""

# ==========================================
# EMAIL SERVICE (RESEND)
# ==========================================
# Resend API key for sending emails
RESEND_API_KEY=""
# Sender email address (must be verified in Resend)
RESEND_SENDER_EMAIL=""

# ==========================================
# OAUTH PROVIDERS
# ==========================================
# Google OAuth credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==========================================
# SECURITY & RATE LIMITING
# ==========================================
# Arcjet API key for security and rate limiting
ARCJET_API=""

# ==========================================
# FILE STORAGE (CLOUDFLARE R2 / S3)
# ==========================================
# S3-compatible endpoint URL
S3_ENDPOINT=""
# S3 bucket name
S3_BUCKET_NAME=""
# S3 region (use "auto" for Cloudflare R2)
S3_REGION="auto"
# AWS token (optional)
AWS_TOKEN=""
# AWS access key ID
AWS_ACCESS_KEY_ID=""
# AWS secret access key
AWS_SECRET_ACCESS_KEY=""

# ==========================================
# WEBSOCKET SERVER
# ==========================================
# WebSocket server URL for real-time features
NEXT_PUBLIC_WEBSOCKET_URL="localhost:8081"

# ==========================================
# PAYMENT GATEWAY (CHARGILY)
# ==========================================
# Chargily secret key (optional in development)
CHARGILY_SK=""
# Chargily public key (visible in client, optional in development)
NEXT_PUBLIC_CHARGILY_PK=""

# ==========================================
# REDIS (UPSTASH)
# ==========================================
# Redis connection URL
REDIS_URL=""

# ==========================================
# OPTIONAL
# ==========================================
# OpenAI API key (optional)
OPEN_AI_API_KEY=""

# Node environment (development, test, production)
NODE_ENV="development"
