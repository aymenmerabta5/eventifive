## Roles System Tables

```typescript
// TEACHING: Role-based access control with userRoles junction table
export const roles = pgTable("roles", {
  id: integer("id").primaryKey().generatedAlwaysAsIdentity(),
  name: rolesEnum("name").notNull().default("user"),
});

export const userRoles = pgTable("user_roles", {
  id: serial("id").primaryKey(),
  userId: text("user_id").references(() => user.id, { onDelete: "cascade" }),
  roleId: integer("role_id").references(() => roles.id, { onDelete: "cascade" }),
  assignedAt: timestamp("assigned_at").notNull().defaultNow(),
});
```

## Session Q&A Tables

```typescript
// TEACHING: Real-time Q&A for program sessions
export const sessionQuestions = pgTable("session_questions", {
  id: text("id").primaryKey(),
  sessionId: text("session_id").references(() => programSession.id),
  userId: text("user_id").references(() => user.id),
  content: text("content").notNull(),
  isAnonymous: boolean("is_anonymous").notNull().default(false),
  isApproved: boolean("is_approved").notNull().default(true),  // For moderation
  isAnswered: boolean("is_answered").notNull().default(false),
  likeCount: integer("like_count").notNull().default(0),
  createdAt: timestamp("created_at").notNull().defaultNow(),
});

export const sessionQuestionLikes = pgTable("session_question_likes", {
  questionId: text("question_id").references(() => sessionQuestions.id),
  userId: text("user_id").references(() => user.id),
  // Unique constraint on (questionId, userId)
});

export const sessionQuestionAnswers = pgTable("session_question_answers", {
  id: text("id").primaryKey(),
  questionId: text("question_id").references(() => sessionQuestions.id),
  userId: text("user_id").references(() => user.id),  // Chair/organizer
  content: text("content").notNull(),
  createdAt: timestamp("created_at").notNull().defaultNow(),
});
```

## Certificates Table

```typescript
// TEACHING: Certificates with snapshots of event/user data at issue time
export const certificate = pgTable("certificate", {
  id: text("id").primaryKey(),
  eventId: text("event_id").references(() => event.id),
  userId: text("user_id").references(() => user.id),
  role: certificateRoleEnum("role").notNull(),  // speaker, committee, reviewer, facilitator
  verificationCode: varchar("verification_code", { length: 20 }).unique().notNull(),

  // Snapshots (preserved even if user/event changes)
  recipientName: varchar("recipient_name", { length: 255 }).notNull(),
  recipientEmail: varchar("recipient_email", { length: 255 }).notNull(),
  eventTitle: varchar("event_title", { length: 255 }).notNull(),
  eventType: eventTypeEnum("event_type").notNull(),
  eventStartDate: timestamp("event_start_date").notNull(),
  eventEndDate: timestamp("event_end_date").notNull(),

  // Timestamps
  issuedAt: timestamp("issued_at").notNull().defaultNow(),
  downloadedAt: timestamp("downloaded_at"),
  revokedAt: timestamp("revoked_at"),
  revokeReason: varchar("revoke_reason", { length: 255 }),
});
```

